# Python 环境和缓存
.venv/
__pycache__/
*.py[cod]

# 本地环境变量和密钥
.env
.env.*
!.env.example

# 官方控制台下载的 OAuth 凭据和本地令牌不进入仓库。
credentials.json
client_secret*.json
token.json

# 测试、开发工具与运行生成物
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
staticfiles/
*.log
db.sqlite3
.idea/

# 执行计划与验证报告仅保留在本地，docs 只跟踪邮箱配置指南。
/docs/*
!/docs/MAILBOX_SETUP.md
