# 复制为 .env 后填写；真实 .env 已被 Git 忽略。
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=UTC
DJANGO_TRUST_PROXY_SSL_HEADER=false
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
LOG_LEVEL=INFO

# 本机端口与容器内部端口分开，减少和已有数据库冲突。
POSTGRES_DB=email_agent
POSTGRES_USER=email_agent
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_SSLMODE=prefer
# 留空复用 Django 数据库；独立检查点数据库可填写 PostgreSQL 连接 URL。
LANGGRAPH_DATABASE_URL=

# 默认平台：bailian / deepseek / openai；不会自动跨平台回退。
LLM_DEFAULT_PROVIDER=bailian
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 百炼：密钥必须与地域匹配，也可以填写业务空间专属域名。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_TEMPERATURE=
DASHSCOPE_EXTRA_BODY={}

# DeepSeek 官方接口；模型名按账户实际可用模型修改。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=
DEEPSEEK_EXTRA_BODY={}

# GPT：默认使用 Responses API，temperature 留空以兼容推理模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_USE_RESPONSES_API=true
OPENAI_TEMPERATURE=
OPENAI_EXTRA_BODY={}

# 默认不向外部追踪服务上传工作流或邮件内容。
LANGSMITH_TRACING=false

# 仅供生产环境 Django 系统通知使用，与后续 Gmail / Outlook 用户邮箱接入分开。
# 本地开发仍使用控制台后端，不需要填写这些凭据。
SYSTEM_SMTP_HOST=localhost
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_USE_TLS=true
SYSTEM_SMTP_USE_SSL=false

# 邮箱只读接入；这组凭据与上面的模型 API Key 分开。
# 加密密钥由 scripts/init_env.py 生成，数据库已有授权后请勿随意更换。
MAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
MAIL_HTTP_TIMEOUT=15
MAIL_MAX_BODY_CHARS=200000
MAIL_MAX_RESPONSE_BYTES=33554432
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/mailboxes/oauth/gmail/callback/
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:8000/mailboxes/oauth/outlook/callback/
